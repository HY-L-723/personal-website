# Copy to .env.auth. Replace placeholders locally; never commit real values.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=your_database
MYSQL_USER=your_database_user
MYSQL_PASSWORD=
AUTH_SITE_URL=http://localhost:3000
AUTH_PORT=3001
# Generate independent random secrets, at least 32 characters each.
AUTH_SECRET=
# Must match AUTH_PROXY_SECRET in .dev.vars.
AUTH_PROXY_SECRET=
AUTH_ADMIN_EMAIL=owner@example.com
# Only used by npm run auth:admin. Clear it after provisioning.
AUTH_ADMIN_PASSWORD=
# Optional: immutable IDs of existing, verified owner accounts.
AUTH_ADMIN_USER_IDS=
